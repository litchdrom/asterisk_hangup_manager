# Copy to `.env` and adjust. Load it into your shell before running, e.g.:
#   set -a && source .env && set +a && python -m asterisk_hangup_manager

# --- Asterisk Manager Interface (AMI) ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=hangup-manager
AMI_SECRET=change-me
# AMI Hangup event field used as the MySQL `dst` lookup key.
AMI_DST_FIELD=Exten

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hangup
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=asterisk
MYSQL_TABLE=hangup_contacts
MYSQL_DST_COLUMN=dst
MYSQL_EMAIL_COLUMN=email
MYSQL_DESCRIPTION_COLUMN=description

# --- SMTP ---
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_SENDER=asterisk@localhost
SMTP_SUBJECT_TEMPLATE=Hangup detected on {dst}

# --- Logging ---
LOG_LEVEL=INFO
