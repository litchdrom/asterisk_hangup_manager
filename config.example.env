# Copy to `.env` and adjust. The service loads `.env` automatically from the
# working directory (or from $ENV_FILE), so you can simply run:
#   python -m asterisk_hangup_manager

# --- Asterisk Manager Interface (AMI) ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=hangup-manager
AMI_SECRET=change-me
# AMI Hangup event field used as the MySQL `dst` lookup key.
AMI_DST_FIELD=Exten
# AMI event that marks a dial/queue attempt as having created an outgoing
# channel. While seen for a call, the call is treated as connected (not missed).
AMI_DIAL_EVENT=DialBegin

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hangup
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=asterisk
MYSQL_TABLE=hangup_contacts
MYSQL_DST_COLUMN=dst
MYSQL_EMAIL_COLUMN=email
MYSQL_DESCRIPTION_COLUMN=description

# --- SMTP ---
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_SENDER=asterisk@localhost
SMTP_SUBJECT_TEMPLATE=Missed call to {dst}
# Optional predefined body. Supports {dst}, {description}, {channel},
# {caller_id} and {cause}. Leave empty to use the built-in body.
SMTP_BODY_TEMPLATE=
# Recipient used when a matched contact row has no email address.
SMTP_FALLBACK_EMAIL=missed-calls@example.com

# --- Logging ---
LOG_LEVEL=INFO
