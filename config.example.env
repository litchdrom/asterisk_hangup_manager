# Copy to `.env` and adjust. The service loads `.env` automatically from the
# working directory (or from $ENV_FILE), so you can simply run:
#   python -m asterisk_hangup_manager

# --- Asterisk Manager Interface (AMI) ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=hangup-manager
AMI_SECRET=change-me
# AMI Hangup event field(s) used as the MySQL `dst` lookup key. May be a
# single field or a comma-separated list tried in order until one has a usable
# value. `Exten` is preferred but is the special `h` hangup-handler extension
# when the call traversed one, so `ConnectedLineNum` is used as a fallback.
AMI_DST_FIELD=Exten,ConnectedLineNum
# AMI event(s) that mark a dial/queue attempt as having created an outgoing
# channel. May be a single event or a comma-separated list. While any is seen
# for a call, the call is treated as connected (not missed). `Dial()` emits
# `DialBegin`, but queue member attempts are reported via `AgentCalled`.
AMI_DIAL_EVENT=DialBegin,AgentCalled
# Missed-call detection mode:
#   hangup - track dial/queue events and the originating hangup (default, no
#            CDR database required).
#   cdr    - react to the AMI `Cdr` event (requires `cdr_manager.conf`) and
#            query the CDR table. More reliable when an IVR answers the caller
#            before a queue/dial attempt, which makes the originating channel's
#            Disposition `ANSWERED` even though no agent ever picked up.
AMI_DETECTION_MODE=hangup
# --- CDR detection mode settings (only used when AMI_DETECTION_MODE=cdr) ---
# AMI event carrying a finalised call detail record.
AMI_CDR_EVENT=Cdr
# `Cdr` event field holding the dialled number used as the `dst` lookup key.
AMI_CDR_DST_FIELD=Destination
# `Cdr` event field naming the last dialplan application executed. Only records
# whose application is in AMI_CDR_APPS are considered.
AMI_CDR_LASTAPP_FIELD=LastApplication
# `Cdr` event field tying the record to the call (the originating channel's
# unique id equals the call's linkedid).
AMI_CDR_LINKEDID_FIELD=UniqueID
# Dialplan applications (comma-separated) whose CDR records represent an attempt
# to reach a destination/agent. Records ending in another application (e.g. an
# IVR `Read`) are ignored.
AMI_CDR_APPS=Dial,Queue

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hangup
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=asterisk
MYSQL_TABLE=hangup_contacts
MYSQL_DST_COLUMN=dst
MYSQL_EMAIL_COLUMN=email
MYSQL_DESCRIPTION_COLUMN=description

# --- CDR table (only used when AMI_DETECTION_MODE=cdr) ---
# Connection settings default to the MYSQL_* values above; set these only when
# the CDR table lives in a separate database (e.g. asteriskcdrdb).
CDR_MYSQL_HOST=
CDR_MYSQL_PORT=
CDR_MYSQL_USER=
CDR_MYSQL_PASSWORD=
CDR_MYSQL_DATABASE=
CDR_TABLE=cdr
CDR_LINKEDID_COLUMN=linkedid
CDR_DISPOSITION_COLUMN=disposition
# A non-empty destination channel tells a real agent/dial leg apart from the
# originating channel's own record, so an IVR self-answer is not counted.
CDR_DSTCHANNEL_COLUMN=dstchannel
CDR_ANSWERED_VALUE=ANSWERED

# --- SMTP ---
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_SENDER=asterisk@localhost
# Subject line. Supports the same placeholders as the body template: {dst},
# {description}, {channel}, {caller_id}, {cause}, {start_time} and {duration}.
SMTP_SUBJECT_TEMPLATE=Missed call to {dst}
# Optional predefined body. Supports {dst}, {description}, {channel},
# {caller_id}, {cause}, {start_time} and {duration}. Leave empty to use the
# built-in body.
SMTP_BODY_TEMPLATE=
# Recipient used when a matched contact row has no email address.
SMTP_FALLBACK_EMAIL=missed-calls@example.com

# --- Logging ---
LOG_LEVEL=INFO
